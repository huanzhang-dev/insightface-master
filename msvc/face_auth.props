<?xml version="1.0" encoding="utf-8"?>
<!-- Compiler settings shared by every project (generated by scripts/make_vs_projects.py). -->
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <FaRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))\</FaRoot>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Keep incompatible compiler objects in separate directories. -->
    <FaBuildFolder Condition="'$(PlatformToolset)' == 'v140'">vs2015</FaBuildFolder>
    <FaBuildFolder Condition="'$(FaBuildFolder)' == ''">vs2019</FaBuildFolder>
    <OutDir>$(FaRoot)build\$(FaBuildFolder)\$(Configuration)\</OutDir>
    <IntDir>$(FaRoot)build\$(FaBuildFolder)\obj\$(Configuration)\$(ProjectName)\</IntDir>
    <!-- The programs read models\, data\ and write build\ relative to the project root. -->
    <LocalDebuggerCommand>$(OutDir)$(TargetName)$(TargetExt)</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(FaRoot)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FaRoot)src\common;$(FaRoot)src\detect;$(FaRoot)src\feature;$(FaRoot)src\match;$(FaRoot)src\store;$(FaRoot)src\camera;$(FaRoot)src\pipeline;$(FaRoot)src\testdata;$(FaRoot)third_party\sqlite;$(FaRoot)third_party\ncnn\include\ncnn;$(FaRoot)third_party\onnxruntime\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- (WIN32_LEAN_AND_MEAN= with an empty value is how ncnn's allocator.h defines it; "=1" would warn about a redefinition.) -->
      <PreprocessorDefinitions>NOMINMAX;_CRT_SECURE_NO_WARNINGS;WIN32_LEAN_AND_MEAN=;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <OpenMPSupport>true</OpenMPSupport>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <MinimalRebuild>false</MinimalRebuild>
      <!-- AVX2 is required: the matcher and the image code use 256-bit instructions. The target PC (4th generation Core i5) has them. -->
      <AdditionalOptions>/arch:AVX2 %(AdditionalOptions)</AdditionalOptions>
      <!-- The ncnn and ONNX Runtime libraries are release builds (/MD), so BOTH configurations use the release runtime. -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <!-- "Debug" = no optimization, full debug information, asserts on; still the release runtime (see above). -->
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
